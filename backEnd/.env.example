# =============================
# Base de datos
# =============================
# URL de conexión a la DB (formato: mysql://USER:PASSWORD@HOST:PORT/DB_NAME)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB_NAME"

# =============================
# Servidor
# =============================
# Puerto donde corre el servidor Express
PORT=5000

# =============================
# Seguridad
# =============================
# Salt rounds para bcrypt (usado en hash de contraseñas)
SALT=10

# Clave secreta para firmar los tokens JWT (ACCESS TOKEN)
JWT_SECRET=your_jwt_secret_here

# Tiempo de expiración del access token (ej: 15m, 1h, 1d)
JWT_EXPIRES_IN=15m

# Tiempo de expiración del refresh token (en días)
REFRESH_TOKEN_DAYS=7

# =============================
# CORS
# =============================
# Lista de orígenes permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# =============================
# Archivos e imágenes
# =============================
# Carpeta donde se guardan las imágenes originales
UPLOADS_DIR=uploads/

# Carpeta donde se guardan los thumbnails
THUMBNAILS_DIR=uploads/thumbnails/

# Ancho máximo para thumbnails (en píxeles)
THUMBNAIL_WIDTH=300

# =============================
# Otros (ejemplo: recaptcha, email, etc.)
# =============================
# Claves de reCAPTCHA (solo si lo agregas)
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Configuración SMTP para enviar emails (reset password, notificaciones, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
