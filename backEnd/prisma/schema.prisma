// -------------------------------------------------------------------------
// Bloque de Configuración (PostgreSQL)
// -------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // CAMBIO 1: Usamos 'postgresql' para Neon
  provider = "postgresql" 
  url      = env("DATABASE_URL")
  // NOTA: 'relationMode' no es necesario para PostgreSQL, solo para MySQL/PlanetScale.
}


// -------------------------------------------------------------------------
// Enums (Sin Cambios)
// -------------------------------------------------------------------------
enum RolUsuario {
  ADMIN
  EMPLEADO 
  CLIENTE
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
  ARCHIVADO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  PENDIENTE
  BLOQUEADO
}

enum CategoriaProducto {
  CUADERNOS
  LAPICES
  FIBRONES
  MOCHILAS
  HOJAS
  IMPRESIONES
  PLASTILINAS
  REGLAS
  OTROS
}

enum TamanoPapel {
  A4
  A5
  A3
  Carta
  Oficio
}

enum TipoPapel {
  Bond
  Opalina
  Couche
  Reciclado
}

enum AcabadoPapel {
  Mate
  Brillante
  Satinado
  Texturizado
}

enum CalidadPapel {
  Económica
  Estándar
  Alta_Calidad
  Premium
}

enum Orientacion {
  VERTICAL
  HORIZONTAL
}

enum EstadoPedido {
  PENDIENTE
  EN_PROCESO
  LISTO
  ENTREGADO
  CANCELADO
}


// -------------------------------------------------------------------------
// Modelos
// -------------------------------------------------------------------------

// MODELO: Usuario
model Usuario {
  // CAMBIO: ID primario a String con cuid()
  id               String          @id @default(cuid()) 
  nombre           String          @db.VarChar(100)
  apellido         String?         @db.VarChar(100)
  email            String          @unique @db.VarChar(100)
  password         String?         @db.VarChar(255)
  rol              RolUsuario      @default(CLIENTE)
  telefono         String?         @unique @db.VarChar(20)
  direccion        String?         @db.VarChar(255)
  estado           EstadoUsuario   @default(ACTIVO)
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt

  pedidos            Pedido[]
  refreshTokens      RefreshToken[]
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
}

// MODELO: RefreshToken
model RefreshToken {
  // CAMBIO: ID primario a String con cuid()
  id         String    @id @default(cuid()) 
  token      String    @unique
  
  // CAMBIO: Clave foránea a String para coincidir con Usuario.id
  usuarioId  String 
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  creadoEn   DateTime  @default(now())
  expiraEn   DateTime
  usado      Boolean   @default(false)
}


// MODELO: Producto
model Producto {
  // CAMBIO: ID primario a String con cuid()
  id              String            @id @default(cuid()) 
  nombre          String            @db.VarChar(100)
  slug            String            @unique
  descripcion     String?           @db.Text
  caracteristicas Json?             @db.Json
  categoria       CategoriaProducto @default(OTROS)
  precio          Float
  stock           Int               @default(0)
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  estado          EstadoProducto    @default(ACTIVO)

  imagenes ImagenProducto[]
  promos   PromoProducto[]
}

// MODELO: ImagenProducto
model ImagenProducto {
  // CAMBIO: ID primario a String con cuid()
  id            String   @id @default(cuid())
  url           String   @db.VarChar(255)
  esPrincipal   Boolean  @default(false)
  
  // CAMBIO: Clave foránea a String para coincidir con Producto.id
  productoId    String 
  producto      Producto @relation(fields: [productoId], references: [id])
}

// MODELO: Promocion
model Promocion {
  // CAMBIO: ID primario a String con cuid()
  id              String            @id @default(cuid())
  titulo          String            @db.VarChar(100)
  codigo          String?           @unique
  descripcion     String?           @db.Text
  imagenes        ImagenPromocion[]
  fechaInicio     DateTime          @default(now())
  fechaFin        DateTime?
  activa          Boolean           @default(true)
  creadaEn        DateTime          @default(now())
  actualizadaEn   DateTime          @updatedAt

  productos       PromoProducto[]
}

// MODELO: PromoProducto (Tabla de Unión)
model PromoProducto {
  // CAMBIO: ID primario a String con cuid()
  id            String    @id @default(cuid())
  
  // CAMBIO: Claves foráneas a String
  productoId    String
  promocionId   String

  producto      Producto  @relation(fields: [productoId], references: [id])
  promocion     Promocion @relation(fields: [promocionId], references: [id])

  @@unique([productoId, promocionId])
}

// MODELO: ImagenPromocion
model ImagenPromocion {
  // CAMBIO: ID primario a String con cuid()
  id            String    @id @default(cuid())
  url           String    @db.VarChar(255)
  
  // CAMBIO: Clave foránea a String
  promocionId   String
  promocion     Promocion @relation(fields: [promocionId], references: [id])
}

// MODELO: Pedido
model Pedido {
  id             String     @id @default(cuid())
  usuarioId      String
  usuario        Usuario    @relation(fields: [usuarioId], references: [id])
  archivo        String?    @db.VarChar(255)
  tamano         TamanoPapel
  tipoPapel      TipoPapel
  acabado        AcabadoPapel
  calidad        CalidadPapel
  cantidad       Int
  orientacion    Orientacion         @default(VERTICAL)
  dobleFaz       Boolean             @default(false)
  encuadernado   Boolean             @default(false)
  perforado      Boolean             @default(false)
  grapado        Boolean             @default(false)
  delivery       Boolean             @default(false)
  fechaEntrega   DateTime?
  horaEntrega    String?             @db.VarChar(20)
  subtotal       Float
  iva            Float
  total          Float               @default(0.0)
  comentarios    String?             @db.Text
  direccionEnvio String?             @db.VarChar(255)
  estado         EstadoPedido        @default(PENDIENTE)
  notasInternas  String?             @db.Text
  creadoEn       DateTime            @default(now())
  actualizadoEn  DateTime            @updatedAt
  HistorialEstadoPedido HistorialEstadoPedido[]
}


// MODELO: HistorialEstadoPedido
model HistorialEstadoPedido {
  // CAMBIO: ID primario a String con cuid()
  id             String         @id @default(cuid())
  
  // CAMBIO: Clave foránea a String
  pedidoId       String
  estadoAnterior EstadoPedido
  estadoNuevo    EstadoPedido
  fecha          DateTime       @default(now())
  cambiadoEn     DateTime       @default(now())
  cambiadoPor    String?

  pedido         Pedido         @relation(fields: [pedidoId], references: [id])
}

// MODELO: Consulta
model Consulta {
  // CAMBIO: ID primario a String con cuid()
  id             String         @id @default(cuid())
  nombre         String         @db.VarChar(100)
  email          String         @db.VarChar(100)
  telefono       String         @db.VarChar(20)
  mensaje        String         @db.Text
  respuesta      String?        @db.Text
  leido          Boolean        @default(false)
  resuelto       Boolean        @default(false)
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt
}