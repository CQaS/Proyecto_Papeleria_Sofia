@baseUrl = http://localhost:5000/api/auth

###

### 🔐 1. Login de usuario
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "fiamma.delcolle@example.com",
  "password": "delcolle"
}

###

### 🆕 2. Registro de nuevo usuario
POST {{baseUrl}}/registro
Content-Type: application/json

{
  "nombre": "Fiamma",
  "apellido": "Del Colle",
  "email": "fiamma.delcolle@example.com",
  "password": "delcolle",
  "telefono": "1234567890",
  "direccion": "Av. Siempre Viva El Volcan"
}
